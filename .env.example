# ============================================
# FLASH ARBITRAGE BOT - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your keys
# Command: cp .env.example .env

# ============================================
# 🔴 REQUIRED - Supabase (Database)
# ============================================
# Get from: https://supabase.com
# Steps: Create Project → Settings → API
# Cost: FREE

VITE_SUPABASE_URL=https://ujhsrxinfcycjtulpvqk.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here


# ============================================
#   REQUIRED - Alchemy (Blockchain RPC)
# ============================================
# Get from: https://dashboard.alchemy.com
# Steps: Create App → Copy API Key
# Cost: FREE (3M requests/month)
# Powers: RPC, Mempool, Simulation, Indexing

VITE_ALCHEMY_API_KEY=your-Alchemy-api-key-here


# ============================================
# 🟡 OPTIONAL - The Graph (Subgraph Queries)
# ============================================
# Get from: https://thegraph.com/studio
# Steps: Connect Wallet → Create API Key
# Cost: FREE (100k queries/month)
# Scope: Frontend/browser usage only (Vite client)
# Edge functions use THEGRAPH_API_KEY in Supabase secrets (or supabase/.env.local for local serve)

VITE_GRAPH_API_KEY=your-graph-api-key-here

# ============================================
# 🟢 OPTIONAL - Notification Webhooks
# ============================================
# These are URLs, not API keys
# Cost: FREE

# Discord: Server Settings → Integrations → Webhooks
VITE_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/xxx

# Telegram Bot Integration (for price alerts)
# Message @BotFather → /newbot → Get token
# Store TELEGRAM_BOT_TOKEN in Supabase Edge Function Secrets (not here!)
# The bot token below is only for legacy direct API calls
VITE_TELEGRAM_BOT_TOKEN=your-telegram-bot-token
VITE_TELEGRAM_CHAT_ID=your-chat-id


# Slack: Apps → Incoming Webhooks → Add New
VITE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx


# ============================================
# DEPLOYED CONTRACT ADDRESSES
# ============================================
# After deploying your arbitrage smart contract,
# paste the addresses here.

# Your deployed arbitrage contract (the "receiver" that gets the flash loan)
VITE_ARBITRAGE_CONTRACT_ADDRESS=0xYourDeployedContractAddressHere

# Flash loan provider address (e.g., Aave V3 Pool on your network)
# Ethereum Mainnet Aave V3: 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2
# Polygon Aave V3: 0x794a61358D6845594F94dc1DB02A252b5b4814aD
# Arbitrum Aave V3: 0x794a61358D6845594F94dc1DB02A252b5b4814aD
VITE_FLASH_LOAN_PROVIDER_ADDRESS=0xYourFlashLoanProviderAddressHere

# Auto execution loop defaults (scanner -> executor wiring)
# Keep AUTO_NETWORKS aligned with currently supported execution networks in flashbots-executor.
AUTO_TRADE_MODE=dry
AUTO_NETWORKS=ethereum,base
AUTO_CONTRACT_ADDRESS=0xYourDeployedContractAddressHere
AUTO_WALLET_ADDRESS=0xYourExecutionWalletAddressHere

# ============================================
# LIVE TRADING SAFETY GATES
# ============================================
# Keep OFF until you've run npm run trading:preflight and validated every check.
VITE_LIVE_TRADING_ENABLED=false

# Recommended risk caps (used by preflight checks and operations runbook)
LIVE_MAX_SLIPPAGE_PERCENT=2.0
LIVE_MAX_LOAN_USD=25000
LIVE_MIN_NET_PROFIT_USD=25
LIVE_MAX_GAS_TO_PROFIT_RATIO=0.4

# Scanner readiness gates (enforced in edge scanner when enabled server-side)
# Configure as Supabase Edge Function secrets for production
SCANNER_ENFORCE_READINESS_GATES=false
SCANNER_MIN_GRAPH_SOURCES_HEALTHY=3
SCANNER_MAX_GRAPH_FALLBACK_SOURCES=2

# ============================================
# SECURITY NOTES
# ============================================
# - Never commit .env to git (already in .gitignore)
# - Never share your private keys
# - Use separate keys for dev/prod
# - Rotate keys if exposed
