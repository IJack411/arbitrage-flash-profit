# ============================================================
# FlashLoanArbitrage — Deployment Environment
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ── Deployer Wallet ─────────────────────────────────────────
# Private key of the wallet that will deploy the contract and become owner.
# This wallet also pays gas. Fund it before deploying.
# You can omit the leading 0x — the config handles both formats.
DEPLOYER_PRIVATE_KEY=your_private_key_here

# ── RPC URLs ────────────────────────────────────────────────
# Get a free key from Alchemy (alchemy.com) or Infura (infura.io).
# Only fill in the network you plan to deploy to.
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# ── Block Explorer API Keys (optional — only needed for verification) ───────
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
ARBISCAN_API_KEY=
POLYGONSCAN_API_KEY=

# ── Gas Reporting (optional) ────────────────────────────────
REPORT_GAS=false
COINMARKETCAP_API_KEY=
