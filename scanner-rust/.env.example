# =============================================================================
# MEV Scanner (Rust) — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# Never commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — Contract & Wallet
# -----------------------------------------------------------------------------

# Your deployed FlashLoanArbitrage contract address
FLASHLIGHT_CONTRACT_ADDRESS=0xYourFlashLightContractAddressHere

# 32-byte hex private key used to sign and submit arbitrage transactions
# MUST be the authorized caller set via setAuthorizedCaller() on the contract
SCANNER_PRIVATE_KEY=0xYourScannerPrivateKeyHere

# 32-byte hex private key used to sign Flashbots bundle requests
# This can be the same as SCANNER_PRIVATE_KEY or a dedicated signer
FLASHBOTS_SIGNER_PRIVATE_KEY=0xYourFlashbotsSignerPrivateKeyHere

# -----------------------------------------------------------------------------
# REQUIRED — RPC Endpoints
# -----------------------------------------------------------------------------
# Provide one URL per network you enable in SCANNER_NETWORKS.
# Alchemy or Infura recommended for low latency.

ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# -----------------------------------------------------------------------------
# REQUIRED — Flashbots
# -----------------------------------------------------------------------------

FLASHBOTS_RELAY_URL=https://relay.flashbots.net

# -----------------------------------------------------------------------------
# OPTIONAL — Data Sources
# -----------------------------------------------------------------------------

# The Graph API key (https://thegraph.com/studio)
# When absent the scanner falls back to RPC-based pricing (less accurate)
THEGRAPH_API_KEY=your-the-graph-api-key-here

# -----------------------------------------------------------------------------
# OPTIONAL — Aave V3 Pool Override
# -----------------------------------------------------------------------------
# Only needed if you want to override the default pool address for the network.
# Defaults:
#   Ethereum:  0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2
#   Arbitrum:  0x794a61358D6845594F94dc1DB02A252b5b4814aD
#   Base:      0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
#   Polygon:   0x794a61358D6845594F94dc1DB02A252b5b4814aD
# AAVE_POOL_ADDRESS=0xOverride...

# -----------------------------------------------------------------------------
# SCANNER — Network Selection
# -----------------------------------------------------------------------------
# Comma-separated list: ethereum, arbitrum, base, polygon
# Start with a single network for testing.
SCANNER_NETWORKS=arbitrum

# -----------------------------------------------------------------------------
# SCANNER — Execution Mode
# -----------------------------------------------------------------------------
# SCANNER_SHADOW_MODE=true  → detect opportunities, log them, but DO NOT submit
# SCANNER_SHADOW_MODE=false → live mode; bundles will be submitted to Flashbots
# Always start in shadow mode and validate output before switching to live.
SCANNER_SHADOW_MODE=true

# -----------------------------------------------------------------------------
# SCANNER — Profit & Risk Thresholds
# -----------------------------------------------------------------------------

# Flash loan size in USD per arbitrage attempt
SCANNER_LOAN_AMOUNT_USD=10000

# Minimum net profit required to promote an opportunity to "active"
SCANNER_MIN_NET_PROFIT_USD=10

# Minimum spread percentage before an opportunity is considered
SCANNER_MIN_SPREAD_PERCENT=0.05

# Minimum pool liquidity in USD (pools below this are ignored)
SCANNER_MIN_LIQUIDITY_USD=50000

# Per-network overrides (optional):
# SCANNER_ARBITRUM_MIN_NET_PROFIT_USD=8
# SCANNER_ETHEREUM_MIN_NET_PROFIT_USD=25

# Maximum slippage tolerance in BPS (1 BPS = 0.01%)
SCANNER_MAX_SLIPPAGE_BPS=300

# Per-network gas price ceiling in Gwei
SCANNER_MAX_GAS_GWEI=100
# SCANNER_ETHEREUM_MAX_GAS_GWEI=200
# SCANNER_ARBITRUM_MAX_GAS_GWEI=0.1

# Maximum quote age before it is considered stale (milliseconds)
SCANNER_MAX_QUOTE_AGE_MS=60000

# How often to run a full scan cycle (milliseconds)
SCANNER_POLL_INTERVAL_MS=5000

# -----------------------------------------------------------------------------
# OBSERVABILITY
# -----------------------------------------------------------------------------

# Prometheus metrics endpoint port
METRICS_PORT=9090

# Log level: trace, debug, info, warn, error
RUST_LOG=info

# Set to true to emit structured JSON logs (useful for log aggregation)
LOG_JSON=false
