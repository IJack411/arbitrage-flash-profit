# Network RPCs
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
ARBITRUM_RPC_URL=
BASE_RPC_URL=
POLYGON_RPC_URL=

# Contract addresses
FLASHLIGHT_CONTRACT_ADDRESS_ETHEREUM=0x0000000000000000000000000000000000000000
AAVE_POOL_ADDRESS_ETHEREUM=0x0000000000000000000000000000000000000000
FLASHLIGHT_CONTRACT_ADDRESS_ARBITRUM=
AAVE_POOL_ADDRESS_ARBITRUM=
FLASHLIGHT_CONTRACT_ADDRESS_BASE=
AAVE_POOL_ADDRESS_BASE=
FLASHLIGHT_CONTRACT_ADDRESS_POLYGON=
AAVE_POOL_ADDRESS_POLYGON=

# Signing
SCANNER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
FLASHBOTS_SIGNER_PRIVATE_KEY=0xYOUR_FLASHBOTS_SIGNER_KEY
FLASHBOTS_RELAY_URL=https://relay.flashbots.net
FLASHBOTS_MAX_PRIORITY_FEE_GWEI=3
FLASHBOTS_FEE_MULTIPLIER=1.15

# Scanner behavior
SCANNER_LOAN_AMOUNT_USD=10000
SCANNER_MIN_NET_PROFIT_USD=14
SCANNER_MIN_SPREAD_PERCENT=0.075
SCANNER_MAX_SLIPPAGE_BPS=40
SCANNER_SCAN_INTERVAL_SECS=5
ENABLE_GRAPH_POLLING=true
ENABLE_RPC_FALLBACK=true
THEGRAPH_API_KEY=

# Logging and metrics
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090

# Telemetry
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ENABLE_SUPABASE_TELEMETRY=false
