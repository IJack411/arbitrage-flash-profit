# Local environment file for `supabase functions serve --env-file supabase/.env.local`
# Copy this file to: supabase/.env.local

# Required by Supabase Edge runtime when using service-role DB calls
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# RPC and execution providers
ALCHEMY_API_KEY=REPLACE_WITH_ALCHEMY_KEY
INFURA_API_KEY=REPLACE_WITH_INFURA_KEY

# The Graph (Edge Functions / server-side scanner)
# Used by: supabase/functions/scan-arbitrage-opportunities and cron-scheduler-24-7
THEGRAPH_API_KEY=REPLACE_WITH_THEGRAPH_API_KEY

# Optional explicit endpoint overrides (leave blank to use defaults)
THEGRAPH_UNI_V3=
THEGRAPH_UNI_V2=
THEGRAPH_SUSHI=
THEGRAPH_BALANCER=
THEGRAPH_CURVE=

# Scanner production-readiness gates (set true in production once validated)
SCANNER_ENFORCE_READINESS_GATES=false
SCANNER_MIN_GRAPH_SOURCES_HEALTHY=3
SCANNER_MAX_GRAPH_FALLBACK_SOURCES=2

# Scanner tuning parameters (all have sensible defaults)
SCANNER_LOAN_AMOUNT_USD=10000
SCANNER_MIN_NET_PROFIT_USD=14
SCANNER_MIN_SPREAD_PERCENT=0.075
SCANNER_MIN_LIQUIDITY_USD=175000
SCANNER_ESTIMATED_GAS_USD=18
SCANNER_MAX_SLIPPAGE_BPS=40
SCANNER_MAX_LIQUIDITY_USAGE_PERCENT=30
SCANNER_MAX_RESULTS=25
SCANNER_NET_PROFIT_GAS_MULTIPLIER=0.35
# Per-network profit thresholds (JSON) - overrides SCANNER_MIN_NET_PROFIT_USD per chain
# SCANNER_MIN_NET_PROFIT_USD_BY_NETWORK={"ethereum":20,"polygon":5,"arbitrum":8,"base":6}

# Notifications
TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY

# Flashbots executor configuration
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
FLASHBOTS_SIGNER_PRIVATE_KEY=REPLACE_WITH_FLASHBOTS_PRIVATE_KEY
FLASHBOTS_RELAY_SIGNING_KEY=REPLACE_WITH_DEDICATED_RELAY_SIGNER
FLASHBOTS_FEE_MULTIPLIER=1.15
FLASHBOTS_MAX_PRIORITY_FEE_GWEI=3
